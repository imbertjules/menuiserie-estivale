# One group is enough. Add it in Vercel on menuiserie-estivale, target Production, then redeploy.
# Nothing is set today, so the form does not send by itself.

# IONOS mailbox already serving menuiserieestivale.fr
SMTP_HOST=smtp.ionos.fr
SMTP_PORT=587
SMTP_USER=contact@menuiserieestivale.fr
SMTP_PASSWORD=
# SMTP_FROM="Menuiserie Estivale <contact@menuiserieestivale.fr>"

# Resend. onboarding@resend.dev only delivers to the Resend account owner.
# RESEND_API_KEY=
# RESEND_FROM="Menuiserie Estivale <contact@menuiserieestivale.fr>"

# Brevo. BREVO_SENDER must already be a verified sender.
# BREVO_API_KEY=
# BREVO_SENDER=contact@menuiserieestivale.fr

# Optional. Defaults to contact@menuiserieestivale.fr
# CONTACT_TO=contact@menuiserieestivale.fr
